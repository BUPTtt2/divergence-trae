# 演策前端环境变量示例
# 复制为 .env.development（本地开发）或 .env.production（生产）按需修改

# 后端 API 地址
# 本地开发：http://localhost:3001
# 生产：https://yance-bagua-engine-production.up.railway.app
VITE_API_BASE=http://localhost:3001

# Sandbox 运行时：默认 agent；仅紧急回滚时显式设为 legacy
VITE_SANDBOX_RUNTIME=agent

# 应用版本号
VITE_APP_VERSION=1.3.0

# 发布指纹：用于比较不同版本的完成率与错误率
VITE_RELEASE_ID=local-development

# 以下只允许配置在服务端环境变量，不得添加 VITE_ 前缀
# 正式管理员账号的用户 ID，多个使用英文逗号分隔；不影响评委匿名体验
ADMIN_USER_IDS=

# 原始行为事件与反馈文字的保留期限
ANALYTICS_EVENT_RETENTION_DAYS=90
FEEDBACK_COMMENT_RETENTION_DAYS=180

{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/[[...path]]" }
  ],
  "functions": {
    "api/[[...path]].js": {
      "maxDuration": 120,
      "memory": 1024
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}

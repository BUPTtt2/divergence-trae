# ===== LLM 提供商配置 =====
# 火山方舟 / 豆包（配置后优先；赛事 Key 只放服务端环境变量）
ARK_API_KEY=
# 推荐：主用 DeepSeek V4 Flash；只在失败、超时或限流时串行切换 GLM。
ARK_PRIMARY_MODEL=deepseek-v4-flash-ga-260731
ARK_FALLBACK_MODELS=glm-5-2-260617
# 兼容旧部署（未配置 ARK_PRIMARY_MODEL 时读取）
ARK_ENDPOINT_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_ENDPOINT_ID=
# 也可直接填模型 ID，例如 doubao-seedream-5-0-pro-260628
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
# 仅填写已授权模型；主模型遇到限额、超时或 5xx 时按顺序切换
SEEDREAM_FALLBACK_MODELS=doubao-seedream-5-0-lite-260128,doubao-seedream-4-5-251128,doubao-seedream-4-0-250828
BLOB_READ_WRITE_TOKEN=
RATE_LIMIT_HASH_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
PUBLIC_APP_URL=
OPS_ALERT_EMAIL=

# 公测 Token 预算；按 /ops 真实用量调整，不应直接设为无限。
LLM_USER_DAILY_TOKEN_BUDGET=60000
LLM_GLOBAL_DAILY_TOKEN_BUDGET=600000
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
WECHAT_CLIENT_ID=
WECHAT_CLIENT_SECRET=
WECHAT_REDIRECT_URI=
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=
QQ_REDIRECT_URI=
SEEDREAM_SIZE=1K
SEEDREAM_TIMEOUT_MS=105000
DOUBAO_INPUT_CNY_PER_MILLION=
DOUBAO_OUTPUT_CNY_PER_MILLION=

# 智谱 AI（免费主力）
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 魔搭 ModelScope
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# ===== 数据库 =====
# Railway PostgreSQL 连接串（未配置时自动降级到内存存储）
DATABASE_URL=

# ===== 服务配置 =====
PORT=3001
# 允许的跨域来源，逗号分隔
CORS_ORIGIN=http://localhost:5173,https://yance-bagua-engine.surge.sh

# ===== LLM 提供商配置 =====
# 火山方舟 / 豆包（配置后优先；赛事 Key 只放服务端环境变量）
ARK_API_KEY=
ARK_ENDPOINT_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_ENDPOINT_ID=
# 也可直接填模型 ID，例如 doubao-seedream-4-5-251128
SEEDREAM_MODEL=
DOUBAO_INPUT_CNY_PER_MILLION=
DOUBAO_OUTPUT_CNY_PER_MILLION=

# 智谱 AI（免费主力）
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 魔搭 ModelScope
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# ===== 数据库 =====
# Railway PostgreSQL 连接串（未配置时自动降级到内存存储）
DATABASE_URL=

# ===== 服务配置 =====
PORT=3001
# 允许的跨域来源，逗号分隔
CORS_ORIGIN=http://localhost:5173,https://yance-bagua-engine.surge.sh

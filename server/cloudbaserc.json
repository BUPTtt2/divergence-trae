{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "envId": "yance-bagua-dev-d1fq4lxm0c0541be",
  "functionRoot": ".",
  "functions": [
    {
      "name": "yance-bagua-engine",
      "type": "HTTP",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 60,
      "memorySize": 512,
      "installDependency": true,
      "envVariables": {
        "PORT": "9000",
        "NODE_ENV": "production",
        "CORS_ORIGIN": "https://yance-bagua.surge.sh"
      },
      "ignore": [
        "node_modules",
        ".memory-db.json",
        "tests",
        "logs",
        ".env",
        ".env.*",
        ".vercel",
        "Dockerfile",
        ".dockerignore",
        "cloudbaserc.json",
        "vercel.json",
        "railway.json",
        "render.yaml",
        "worker"
      ]
    }
  ]
}
